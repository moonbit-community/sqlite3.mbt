supported_targets = "native+wasm"

// The imports are target-specific: `moonbitlang/async` is only used by
// ffi_async_wasm.mbt (wasm) and `moonbitlang/async/types` only by
// ffi_native.mbt (native). moon.pkg has no per-target imports, so each target
// reports the other's import as unused (warning 29, unused_package).

warnings = "-29"

import {
  "moonbitlang/async",
  "moonbitlang/async/os_error",
  "moonbitlang/async/pipe",
  "moonbitlang/async/types",
}

options(
  "native-stub": [
    "stub.c",
    "executor.c",
    "job.c",
    "open_job.c",
    "prepare_job.c",
    "step_job.c",
    "sqlite3.c",
  ],
  targets: {
    "ffi.mbt": [ "native", "wasm" ],
    "ffi_async.mbt": [ "native" ],
    "ffi_async_wasm.mbt": [ "wasm" ],
    "ffi_native.mbt": [ "native" ],
    "ffi_wasm.mbt": [ "wasm" ],
  },
)
