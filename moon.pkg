import {
  "moonbitlang/async",
  "moonbitlang/async/os_error",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/core/lexbuf",
  "moonbit-community/sqlite3/internal/ffi",
}

import {
  "moonbitlang/core/test",
  "moonbitlang/async/fs",
} for "test"

// The compiler currently emits warning 79 for public derived/implemented
// traits even when their methods are intentionally not promoted. Block-level
// suppression does not cover this interface diagnostic, while explicit
// extensions would add method-form APIs to the generated interface.

warnings = "-79"

supported_targets = "native+wasm"
